Cell["Calculate Christoffel connection of the second kind", "Text",
 CellChangeTimes->{{3.9171876874697676`*^9, 
  3.917187720199856*^9}},ExpressionUUID->"f71fa683-8ebf-4e33-8f65-\
3ee29ee0a374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"secondgamma", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "i", ",", "n"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "n", ",", "j"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "n", ",", "k"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "j", ",", "k"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "4"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9171877213583317`*^9, 3.917187822005578*^9}, 
   3.9172683555714626`*^9, {3.917621836101853*^9, 3.917621855402609*^9}, {
   3.917631147850112*^9, 3.917631152645596*^9}, 3.917631433702815*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"bf7891c1-567b-4772-b0dd-359eeb00ecac"],

Cell["\<\
Calculate the Riemann tensor. This has the first index raised and the final \
three lowered.\
\>", "Text",
 CellChangeTimes->{{3.9171864990003695`*^9, 3.917186508199854*^9}, {
  3.9176314507459493`*^9, 
  3.9176314636389885`*^9}},ExpressionUUID->"44b00aa2-3d05-4b6d-99d2-\
e38d98ec6bd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"riemann", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"secondgamma", ",", "i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"coords", "[", 
           RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Part", "[", 
          RowBox[{"secondgamma", ",", "i", ",", "l", ",", "j"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Part", "[", 
             RowBox[{"secondgamma", ",", "i", ",", "l", ",", "s"}], "]"}]}], 
           "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "k"}], "]"}]}], 
          " ", "+", 
          RowBox[{
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "i", ",", "k", ",", "s"}], "]"}], "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "l"}], "]"}]}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "4"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9171865986512823`*^9, 3.9171867243677816`*^9}, {
  3.9171867590927315`*^9, 3.917186920094795*^9}, {3.917186971327074*^9, 
  3.917187034255534*^9}, {3.91718708844083*^9, 3.9171871471647215`*^9}, {
  3.9171872303523197`*^9, 3.917187277504341*^9}, {3.9171876193915434`*^9, 
  3.9171876497997713`*^9}, {3.917187838351283*^9, 3.917187872727564*^9}, {
  3.917276985373625*^9, 3.917277003970087*^9}, {3.917622146841715*^9, 
  3.917622184605811*^9}, {3.9176241719847903`*^9, 3.917624190610099*^9}, {
  3.9176244587132607`*^9, 3.9176244598379564`*^9}, {3.9176304819243116`*^9, 
  3.9176304821742105`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"d73a9516-7cd9-4e67-b50f-c7931f47a837"],

Cell["\<\

Raise all indices of the Riemann tensor\
\>", "Text",
 CellChangeTimes->{{3.9176314681220474`*^9, 
  3.9176314793852386`*^9}},ExpressionUUID->"3a81d6de-19ce-4741-9b75-\
e9d4790ab01a"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"riemannraised", " ", "=", " ", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "g", ",", "d"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "f", ",", "c"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "e", ",", "b"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"riemann", ",", "a", ",", "b", ",", "c", ",", "d"}], 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"b", ",", "1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], " ", "]"}], " ", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"a", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"g", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.917187318919819*^9, 3.9171873548485546`*^9}, {
  3.9171874417363834`*^9, 3.9171874546845646`*^9}, {3.9171961763421483`*^9, 
  3.917196240235304*^9}, {3.9171962771109962`*^9, 3.9171964559259253`*^9}, {
  3.9172669703756847`*^9, 3.9172669732971325`*^9}, {3.9172771648240795`*^9, 
  3.9172771757578897`*^9}, {3.917277206170632*^9, 3.9172772075615873`*^9}, {
  3.917277376880168*^9, 3.91727742035985*^9}, {3.917277458204539*^9, 
  3.91727762770516*^9}, {3.91727766748444*^9, 3.9172776928542576`*^9}, {
  3.917622832523447*^9, 3.9176228697680793`*^9}, {3.9176245997424536`*^9, 
  3.9176247094891424`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"c24bfa1e-d0df-4179-9885-8e85a3ffb67e"],

Cell["\<\

Lower all indices of the Riemann tensor\
\>", "Text",
 CellChangeTimes->{{3.917631491413455*^9, 
  3.917631500395902*^9}},ExpressionUUID->"1e11248e-90e2-4031-ae56-\
dcdf326c28a4"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"riemannlowered", " ", "=", " ", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"metric", ",", "e", ",", "a"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"riemann", ",", "a", ",", "b", ",", "c", ",", "d"}], 
           "]"}]}], " ", ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"e", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.917624710301151*^9, 3.9176247823127356`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"29f9617c-caf3-40de-8579-9aea15f1e659"],

Cell["\<\

Calculate the Kretschmann scalar by fully contracting the Riemann tensor with \
itself.\
\>", "Text",
 CellChangeTimes->{{3.917631504285466*^9, 
  3.9176315632959337`*^9}},ExpressionUUID->"663203a3-1afd-4478-b5f4-\
ab22c2947a6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"riemannlowered", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "]"}], "*", 
           RowBox[{"riemannraised", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"c", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.917196438602275*^9, 3.9171964451605473`*^9}, {
  3.9172666805024824`*^9, 3.9172667801587977`*^9}, {3.9172771936043167`*^9, 
