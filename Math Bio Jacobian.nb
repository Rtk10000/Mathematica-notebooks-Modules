Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f1Case1", "[", 
    RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "x1"}], " ", "+", " ", 
    RowBox[{"1.5", "*", 
