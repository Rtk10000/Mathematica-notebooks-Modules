   3.917631610128912*^9}},ExpressionUUID->"4158dc7b-efde-49fe-b584-\
7a7838b491ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"metric", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", "*", 
           RowBox[{"M", "/", "r"}]}]}], ",", " ", "0", ",", " ", "0", ",", 
         " ", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"2", "*", 
             RowBox[{"M", "/", "r"}]}]}], ")"}]}], ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"r", "^", "2"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"metric", "//", "MatrixForm"}]}]}]], "Input",
 CellChangeTimes->{{3.917180273766288*^9, 3.9171804378177195`*^9}, {
  3.91718101241556*^9, 3.9171810204626665`*^9}, {3.917182235448857*^9, 
  3.917182249087203*^9}, {3.917621382744306*^9, 3.917621383087654*^9}, {
  3.9176215928001966`*^9, 3.917621593832111*^9}, {3.917631330169019*^9, 
  3.917631330871764*^9}},
 CellLabel->
