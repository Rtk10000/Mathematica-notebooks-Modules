Cell[TextData[StyleBox["Calculate the Riemann tensor. This has the first \
index raised and the final three lowered.", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.9171864990003695`*^9, 3.917186508199854*^9}, {
