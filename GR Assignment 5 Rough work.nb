Cell[CellGroupData[{
Cell["\<\

Question 3)b)\
\>", "Section",
 CellChangeTimes->{{3.9217775487753277`*^9, 
  3.921777556542288*^9}},ExpressionUUID->"79a0b5d9-5d1a-43ee-b5c6-\
ee2f3258e8cb"],

Cell[CellGroupData[{

Cell["\<\
Define the cubic equation for rc
\
\>", "Subsection",
 CellChangeTimes->{{3.921777142580819*^9, 
  3.921777150065121*^9}},ExpressionUUID->"42a949f6-5900-4001-bd05-\
72ff98acafd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cubic", "[", 
    RowBox[{"r_", ",", " ", "M_", ",", " ", "a_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"3", " ", "M"}]}], ")"}], "^", "2"}]}], "-", 
    RowBox[{"4", " ", 
     RowBox[{"a", "^", "2"}], " ", "M"}]}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9217771561408772`*^9, 3.9217771684152007`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"0325dafa-9289-4a83-90db-b28e1e5e8b84"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "4"}], " ", 
   SuperscriptBox["a", "2"], " ", "M"}], "+", 
  RowBox[{"r", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], " ", "M"}], "+", "r"}], ")"}], "2"]}]}]], "Output",
 CellChangeTimes->{3.9217771694215345`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"4f0bade5-8af4-44c5-b221-d0623edbac95"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

Define the Light Ring prograde/retrograde equations for r .\
\>", "Subsection",
 CellChangeTimes->{{3.921777240690327*^9, 
  3.9217772422908883`*^9}},ExpressionUUID->"3a863789-207b-4266-abd4-\
47ec2cbeb94b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rLRprograde", "[", 
    RowBox[{"M_", ",", "a_"}], "]"}], " ", "=", " ", 
   RowBox[{"2", " ", "M", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"2", "/", "3"}], "*", 
        RowBox[{"ArcCos", "[", 
         RowBox[{"a", "/", "M"}], "]"}]}], "]"}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9217772482865763`*^9, 3.921777254654373*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"e5bdcfb7-11d6-49b6-8e58-e2f98ec03f43"],

Cell[BoxData[
 RowBox[{"2", " ", "M", " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox["2", "3"], " ", 
      RowBox[{"ArcCos", "[", 
       FractionBox["a", "M"], "]"}]}], "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9217772552162266`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"9a78c386-d22e-49e2-98df-8ea61d625fca"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rLRretrograde", "[", 
    RowBox[{"M_", ",", "a_"}], "]"}], " ", "=", " ", 
   RowBox[{"2", " ", "M", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"2", "/", "3"}], "*", 
        RowBox[{"ArcCos", "[", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "M"}], "]"}]}], "]"}]}], 
     ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.921777261289255*^9, 3.9217772614672422`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"59733602-29ba-4727-b638-ccee805018be"],

Cell[BoxData[
 RowBox[{"2", " ", "M", " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox["2", "3"], " ", 
      RowBox[{"ArcCos", "[", 
       RowBox[{"-", 
        FractionBox["a", "M"]}], "]"}]}], "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9217772621572256`*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"1afdfb19-df99-4a30-989a-5c3d3ff823f4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

Put the Light ring equations into the cubic equation and see if it evaluates \
to zero . If it does, then (5.18) is numerically verified .\
\>", "Subsection",
 CellChangeTimes->{{3.921777269520851*^9, 
  3.9217772799483275`*^9}},ExpressionUUID->"bef9be1a-ead8-4363-9155-\
47c4dd843d26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cubic", "[", 
    RowBox[{
     RowBox[{"rLRprograde", "[", 
      RowBox[{"M", ",", "a"}], "]"}], ",", "M", ",", "a"}], "]"}], "//", 
   "Simplify"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9217772851650305`*^9, 3.9217772913897343`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"4f0d998b-6fec-4aa4-8463-27b731c7159e"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.921777292253414*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"290a4e89-f2a4-4671-8a98-63d9c3e7d1ed"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"cubic", "[", 
    RowBox[{
     RowBox[{"rLRretrograde", "[", 
      RowBox[{"M", ",", "a"}], "]"}], ",", "M", ",", "a"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.921777299630657*^9, 3.9217772997795563`*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"56849e61-b33a-4171-a550-1c3346f10ff1"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.921777300730788*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"146febe1-23f6-43a1-be17-91fd42b71edc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

Second method: Plot r(r-3M)^2 and 4a^2M vs a \[Element][0,1] as suggested in \
the question\
\>", "Subsection",
 CellChangeTimes->{{3.9217773023869004`*^9, 
  3.92177736338177*^9}},ExpressionUUID->"9b7e4b7b-022f-42ab-8254-\
b5b0b3a0d97d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"M", " ", "=", " ", "1"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"rLRprograde", "[", 
       RowBox[{"M", ",", "a"}], "]"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"rLRprograde", "[", 
          RowBox[{"M", ",", "a"}], "]"}], "-", 
         RowBox[{"3", " ", "M"}]}], ")"}], "^", "2"}]}], ",", " ", 
     RowBox[{"4", " ", 
      RowBox[{"a", "^", "2"}], " ", "M"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9217773646508117`*^9, 3.921777439383712*^9}},
