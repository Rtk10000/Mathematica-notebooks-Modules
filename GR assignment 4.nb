Cell["\<\
Finging Gamma using mathematica Table[] and Sum[] commands which were found \
from the following Mathematica notebook written by J. Hartle. \
https://web.physics.ucsb.edu/~gravitybook/math/curvature.pdf:\
\>", "Text",
 CellChangeTimes->{{3.9171843960327945`*^9, 3.9171844145670924`*^9}, {
   3.91718459520829*^9, 3.9171846326017065`*^9}, {3.917184835658228*^9, 
   3.917184853471795*^9}, 
   3.917276932746273*^9},ExpressionUUID->"24303198-5b87-4ec4-81cf-\
f3af3b0426f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Set", " ", "up", " ", "list", " ", "of", " ", "coordinates", " ", "to", 
    " ", "differentiate", " ", "with", " ", "respect", " ", "to"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"coords", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "phi"}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9171856784703703`*^9, 3.917185717912797*^9}, 
   3.9176313495459533`*^9},
 CellLabel->
  "In[946]:=",ExpressionUUID->"01bc3105-29b3-4f11-9cdd-3dd3617fd722"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "phi"}], "}"}]], "Output",
 CellChangeTimes->{3.9174480826129785`*^9, 3.91762107563113*^9, 
  3.91763135301569*^9},
 CellLabel->
  "Out[946]=",ExpressionUUID->"d053bec7-7287-4a6d-b10b-38501dea939a"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"gamma", " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Part", "[", 
             RowBox[{"metric", ",", "i", ",", "j"}], "]"}], ",", 
            RowBox[{"coords", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Part", "[", 
             RowBox[{"metric", ",", "i", ",", "k"}], "]"}], ",", 
            RowBox[{"coords", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "-", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Part", "[", 
             RowBox[{"metric", ",", "j", ",", "k"}], "]"}], ",", 
            RowBox[{"coords", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "4"}], "}"}]}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9171844192926745`*^9, 3.9171845675952587`*^9}, {
   3.9171848577132993`*^9, 3.9171849301222506`*^9}, {3.9171849765916023`*^9, 
   3.917184999257431*^9}, {3.917185137468539*^9, 3.9171851614368067`*^9}, {
   3.9171852768533278`*^9, 3.917185332927906*^9}, {3.917185392147354*^9, 
   3.917185398567412*^9}, {3.917185474256424*^9, 3.917185489707115*^9}, {
   3.917185723888404*^9, 3.9171857292557507`*^9}, 3.9171857752508554`*^9, 
   3.917185876539604*^9, {3.9171859132647867`*^9, 3.917185914706981*^9}, {
   3.917186131661416*^9, 3.9171861331627493`*^9}, {3.9171861703470483`*^9, 
   3.91718617039423*^9}, {3.9171862130349274`*^9, 3.917186218653658*^9}, {
   3.917186465900361*^9, 3.9171864741592135`*^9}, 3.917276952489197*^9, {
   3.9174480903670435`*^9, 3.917448091321118*^9}, {3.917621799281642*^9, 
   3.9176218294796715`*^9}},
 CellLabel->
  "In[951]:=",ExpressionUUID->"4dfe0e9b-bb71-4d70-88d7-ea57fac58f8c"],

Cell["Calculate Christoffel connection of the second kind", "Text",
 CellChangeTimes->{{3.9171876874697676`*^9, 
  3.917187720199856*^9}},ExpressionUUID->"f71fa683-8ebf-4e33-8f65-\
3ee29ee0a374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"secondgamma", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "i", ",", "n"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "n", ",", "j"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "n", ",", "k"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Part", "[", 
               RowBox[{"metric", ",", "j", ",", "k"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "4"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9171877213583317`*^9, 3.917187822005578*^9}, 
   3.9172683555714626`*^9, {3.917621836101853*^9, 3.917621855402609*^9}, {
   3.917631147850112*^9, 3.917631152645596*^9}, 
   3.917631433702815*^9},ExpressionUUID->"bf7891c1-567b-4772-b0dd-\
359eeb00ecac"],

Cell["\<\
Calculate the Riemann tensor. This has the first index raised and the final \
three lowered.\
\>", "Text",
 CellChangeTimes->{{3.9171864990003695`*^9, 3.917186508199854*^9}, {
  3.9176314507459493`*^9, 
  3.9176314636389885`*^9}},ExpressionUUID->"44b00aa2-3d05-4b6d-99d2-\
e38d98ec6bd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"riemann", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"secondgamma", ",", "i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"coords", "[", 
           RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Part", "[", 
          RowBox[{"secondgamma", ",", "i", ",", "l", ",", "j"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Part", "[", 
             RowBox[{"secondgamma", ",", "i", ",", "l", ",", "s"}], "]"}]}], 
           "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "k"}], "]"}]}], 
          " ", "+", 
          RowBox[{
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "i", ",", "k", ",", "s"}], "]"}], "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "l"}], "]"}]}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "4"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9171865986512823`*^9, 3.9171867243677816`*^9}, {
  3.9171867590927315`*^9, 3.917186920094795*^9}, {3.917186971327074*^9, 
  3.917187034255534*^9}, {3.91718708844083*^9, 3.9171871471647215`*^9}, {
  3.9171872303523197`*^9, 3.917187277504341*^9}, {3.9171876193915434`*^9, 
  3.9171876497997713`*^9}, {3.917187838351283*^9, 3.917187872727564*^9}, {
  3.917276985373625*^9, 3.917277003970087*^9}, {3.917622146841715*^9, 
  3.917622184605811*^9}, {3.9176241719847903`*^9, 3.917624190610099*^9}, {
  3.9176244587132607`*^9, 3.9176244598379564`*^9}, {3.9176304819243116`*^9, 
  3.9176304821742105`*^9}},
 CellLabel->
  "In[954]:=",ExpressionUUID->"d73a9516-7cd9-4e67-b50f-c7931f47a837"],

Cell["\<\

Raise all indices of the Riemann tensor\
\>", "Text",
 CellChangeTimes->{{3.9176314681220474`*^9, 
  3.9176314793852386`*^9}},ExpressionUUID->"3a81d6de-19ce-4741-9b75-\
e9d4790ab01a"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"riemannraised", " ", "=", " ", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "g", ",", "d"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "f", ",", "c"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"inversemetric", ",", "e", ",", "b"}], "]"}], "*", 
          RowBox[{"Part", "[", 
           RowBox[{"riemann", ",", "a", ",", "b", ",", "c", ",", "d"}], 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"b", ",", "1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", "1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], " ", "]"}], " ", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"a", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"g", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
   ";"}]}]], "Input",
