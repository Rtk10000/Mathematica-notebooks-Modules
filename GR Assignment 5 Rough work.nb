           SuperscriptBox["u", "3"]}]]}]}]]]}], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "M", " ", "u"}], "-", 
        RowBox[{"a", " ", 
         SqrtBox[
          RowBox[{"M", " ", 
           SuperscriptBox["u", "3"]}]]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["u", "2"]], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "M", " ", "u"}]}], ")"}]}]}], ")"}]}], 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"3", " ", "M", " ", "u"}], "-", 
       RowBox[{"2", " ", "a", " ", 
        SqrtBox[
         RowBox[{"M", " ", 
          SuperscriptBox["u", "3"]}]]}]}]]]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.9217506055059586`*^9, 3.9217737435999355`*^9, {3.9217741398371162`*^9, 
   3.9217741519480715`*^9}, 3.921775571985773*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"5dc81a0e-b162-4bf4-8b7d-9ff5fe01c1b5"]
