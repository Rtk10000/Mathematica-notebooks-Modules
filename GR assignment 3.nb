Cell[BoxData[
 RowBox[{
  RowBox[{"riemann", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Part", "[", 
           RowBox[{"secondgamma", ",", "i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"coords", "[", 
           RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Part", "[", 
          RowBox[{"secondgamma", ",", "i", ",", "l", ",", "j"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Part", "[", 
             RowBox[{"secondgamma", ",", "i", ",", "l", ",", "s"}], "]"}]}], 
           "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "k"}], "]"}]}], 
          " ", "+", 
          RowBox[{
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "i", ",", "k", ",", "s"}], "]"}], "*", 
           RowBox[{"Part", "[", 
            RowBox[{"secondgamma", ",", "s", ",", "j", ",", "l"}], "]"}]}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "4"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
