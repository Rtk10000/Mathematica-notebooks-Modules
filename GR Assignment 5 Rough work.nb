Cell[CellGroupData[{

Cell["\<\

Unsuccessful. Does \[CapitalOmega]prograde==(5.33)?\
\>", "Subsection",
 CellChangeTimes->{{3.9217779301156654`*^9, 
  3.9217779634719105`*^9}},ExpressionUUID->"0697d539-d52d-4719-83f1-\
12a72b37895a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[CapitalOmega]prograde", " ", "\[Equal]", 
    RowBox[{
     RowBox[{"Sqrt", "[", "M", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"u", "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]}]}], "+", 
       RowBox[{"a", " ", 
        RowBox[{"Sqrt", "[", "M", "]"}]}]}], ")"}]}]}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.921773744865423*^9, 3.9217738065367312`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"9959d9d1-c0c9-4860-8cfa-f745e91f1848"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", "a", " ", "M", " ", "u", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "M", " ", "u"}], "+", 
         RowBox[{"a", " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SuperscriptBox["u", "3"]}]]}]}], ")"}]}], 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"3", " ", "M", " ", "u"}], "+", 
        RowBox[{"2", " ", "a", " ", 
         SqrtBox[
          RowBox[{"M", " ", 
           SuperscriptBox["u", "3"]}]]}]}]]], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "M", " ", "u"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["u", "2"]}], "-", 
        RowBox[{"2", " ", "a", " ", 
         SqrtBox[
          RowBox[{"M", " ", 
           SuperscriptBox["u", "3"]}]]}]}], ")"}], " ", 
      SqrtBox[
       FractionBox["M", 
        RowBox[{"u", "-", 
         RowBox[{"3", " ", "M", " ", 
          SuperscriptBox["u", "2"]}], "+", 
         RowBox[{"2", " ", "a", " ", "u", " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SuperscriptBox["u", "3"]}]]}]}]]]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "a", " ", "M", " ", "u", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["u", "2"]}], "-", 
        RowBox[{"2", " ", "a", " ", 
         SqrtBox[
          RowBox[{"M", " ", 
           SuperscriptBox["u", "3"]}]]}]}], ")"}], " ", 
