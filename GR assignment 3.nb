Cell[CellGroupData[{

Cell["\<\
Question 3. Plot dA[z] and \[Delta]\[Theta][z].
\
\>", "Subsection",
 CellChangeTimes->{{3.9192609004966226`*^9, 
  3.9192609337775574`*^9}},ExpressionUUID->"5f775858-68b1-4050-a072-\
84f2e01c1bcf"],

Cell[CellGroupData[{

Cell["\<\

Define Einstein-de Sitter angular distance dA[z], and angle in the sky \
\[Delta]\[Theta][z].\
\>", "Subsubsection",
 CellChangeTimes->{{3.919260936710659*^9, 
  3.9192609841583414`*^9}},ExpressionUUID->"0fd7580b-43cb-4ae0-a556-\
892cdf053fa7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dAeinstein", "[", 
    RowBox[{"z_", ",", " ", "c_", ",", " ", "Ho_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], "*", 
    RowBox[{"c", "/", 
     RowBox[{"(", 
      RowBox[{"Ho", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}]}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}], "-", "1"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9192609850303183`*^9, 3.9192610440555162`*^9}},
 CellLabel->
  "In[133]:=",ExpressionUUID->"a349eef4-1a37-4963-97ca-0bdb25867028"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"2", " ", "c", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{"1", "+", "z"}]]]}], ")"}]}], 
   RowBox[{"Ho", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{3.9192610452580767`*^9, 3.919261202166199*^9, 
  3.9199251119279003`*^9},
 CellLabel->
  "Out[133]=",ExpressionUUID->"8cbce4bc-bb19-48ae-97ac-dcf43fc5038f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]\[Theta]einstein", "[", 
   RowBox[{"z_", ",", " ", "c_", ",", " ", "Ho_", ",", " ", "d_"}], "]"}], 
  " ", "=", " ", 
  RowBox[{"d", "/", 
   RowBox[{"dAeinstein", "[", 
    RowBox[{"z", ",", "c", ",", "Ho"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9192610465077815`*^9, 3.9192611059416656`*^9}, {
