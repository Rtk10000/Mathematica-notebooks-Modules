16c15ebce4bf"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"D", " ", "Ho", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}]}], 
   RowBox[{"2", " ", "c", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{"1", "+", "z"}]]]}], ")"}]}]]}]], "Output",
 CellChangeTimes->{3.9192610609109745`*^9, 3.919261107191162*^9, 
  3.9199251129276648`*^9},
