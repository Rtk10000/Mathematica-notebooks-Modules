0f07f6dc1f7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"infalltime", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", "r"}], "-", 
           RowBox[{"1", "/", "R"}]}], ")"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "R"}], "}"}]}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9176175732793393`*^9, 3.9176175816057796`*^9}, {
