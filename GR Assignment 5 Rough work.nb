Cell[CellGroupData[{

Cell["\<\

Apparently \[CapitalOmega]prograde != (5.33).

Do the second approach by evaluating the roots of the quadratic for \
\[CapitalOmega].\
\>", "Subsection",
 CellChangeTimes->{{3.9217779675175924`*^9, 
  3.9217780231197157`*^9}},ExpressionUUID->"ec0bc993-f84b-4210-a4dc-\
b8d782f4e0e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "M", " ", "a", " ", "u"}], " ", "+", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"16", " ", 
         RowBox[{"M", "^", "2"}], " ", 
         RowBox[{"a", "^", "2"}], " ", 
         RowBox[{"u", "^", "2"}]}], " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"tdot", "[", 
             RowBox[{
              RowBox[{"1", "/", "u"}], ",", "e", ",", "L"}], "]"}]}], "-", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", " ", "M", " ", "u"}]}], ")"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"u", "^", "2"}]}], " ", "+", " ", 
           RowBox[{"a", "^", "2"}], " ", "+", " ", 
           RowBox[{"2", " ", "M", " ", 
            RowBox[{"a", "^", "2"}], " ", "u"}]}], ")"}]}]}], "]"}]}], ")"}], 
    "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"u", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"a", "^", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "M", " ", 
         RowBox[{"a", "^", "2"}], " ", "u"}]}], ")"}]}], ")"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9217762209647408`*^9, 3.9217764191995587`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"0b624d8d-d89d-4fdf-bb94-5bd2ef117891"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"4", " ", "a", " ", "M", " ", "u"}], "+", 
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"16", " ", 
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["M", "2"], " ", 
        SuperscriptBox["u", "2"]}], "-", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           SuperscriptBox["u", "2"]], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "M", " ", "u"}]}], ")"}]}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "M", " ", "u"}], "+", 
          FractionBox[
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "M", " ", "u"}], "+", 
            RowBox[{
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["u", "2"]}]}], 
           RowBox[{"e", "-", 
            RowBox[{"2", " ", "a", " ", "L", " ", "M", " ", 
             SuperscriptBox["u", "3"]}], "+", 
            RowBox[{
             SuperscriptBox["a", "2"], " ", "e", " ", 
             SuperscriptBox["u", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", " ", "M", " ", "u"}]}], ")"}]}]}]]}], ")"}]}]}], 
      ")"}]}]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["u", "2"]], "+", 
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "M", " ", "u"}]}], ")"}]}]}], ")"}]}], 
   ")"}]}]], "Output",
